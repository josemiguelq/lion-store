# URL pública base usada para montar os links enviados ao cliente.
# Em produção coloque o domínio real (ex: https://promo.seudominio.com.br)
BASE_URL=http://localhost:3000

# Site que será embedado no iframe (fica só no servidor, nunca vai pro HTML)
TARGET_URL=https://liondistribuidora.com.br/

# Conexão com o Redis (usada apenas no servidor)
REDIS_URL=redis://localhost:6379

# Credenciais do painel /admin (Basic Auth). TROQUE A SENHA!
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Limites de duração (em minutos) permitidos ao gerar um link
MIN_MINUTES=1
MAX_MINUTES=1440
